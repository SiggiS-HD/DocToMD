{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doctomd.local/schemas/conversion-manifest-1.0.json",
  "title": "DocToMD conversion manifest",
  "description": "Nachvollziehbares Ergebnis einer DocToMD-Konvertierung.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_schema_version",
    "created_at",
    "source",
    "conversion",
    "artifacts",
    "quality"
  ],
  "properties": {
    "manifest_schema_version": {
      "const": "1.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "conversion": {
      "$ref": "#/$defs/conversion"
    },
    "artifacts": {
      "$ref": "#/$defs/artifacts"
    },
    "quality": {
      "$ref": "#/$defs/quality"
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "pageReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_number"],
      "properties": {
        "page_number": {
          "type": "integer",
          "minimum": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "media_type", "size_bytes", "sha256", "modified_at"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "modified_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "conversion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "output_format", "started_at", "completed_at", "components", "options"],
      "properties": {
        "status": {
          "enum": ["success", "partial", "failure"]
        },
        "output_format": {
          "const": "markdown"
        },
        "started_at": {
          "$ref": "#/$defs/timestamp"
        },
        "completed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "components": {
          "type": "object",
          "additionalProperties": false,
          "required": ["engine"],
          "properties": {
            "engine": {
              "$ref": "#/$defs/component"
            },
            "extractor": {
              "$ref": "#/$defs/component"
            },
            "ocr": {
              "$ref": "#/$defs/component"
            },
            "layout": {
              "$ref": "#/$defs/component"
            }
          }
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ocr_mode", "ocr_language"],
          "properties": {
            "ocr_mode": {
              "enum": ["auto", "off", "force"]
            },
            "ocr_language": {
              "type": "string",
              "minLength": 1
            },
            "page_range": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "cloud_document": {
          "$ref": "#/$defs/cloudDocumentTelemetry"
        },
        "ocr": {
          "$ref": "#/$defs/ocrResult"
        }
      }
    },
    "cloudCostEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount_usd", "source_url", "retrieved_at"],
      "properties": {
        "amount_usd": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "retrieved_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "ocrResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_word_confidence", "pages"],
      "properties": {
        "min_word_confidence": {"type": "integer", "minimum": 0, "maximum": 100},
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["page_number", "word_count", "average_word_confidence"],
            "properties": {
              "page_number": {"type": "integer", "minimum": 1},
              "word_count": {"type": "integer", "minimum": 0},
              "average_word_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 100}
            }
          }
        }
      }
    },
    "cloudDocumentTelemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "response_id",
        "model_id",
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "started_at",
        "completed_at",
        "duration_ms"
      ],
      "properties": {
        "response_id": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "input_tokens": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "output_tokens": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "total_tokens": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "started_at": {
          "$ref": "#/$defs/timestamp"
        },
        "completed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "cost": {
          "$ref": "#/$defs/cloudCostEvidence"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "kind", "path", "page"],
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["image", "table"]
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "page": {
          "$ref": "#/$defs/pageReference"
        },
        "caption": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "contentReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "page"],
      "properties": {
        "kind": {
          "enum": ["text", "table", "asset"]
        },
        "page": {
          "$ref": "#/$defs/pageReference"
        },
        "asset_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["markdown_path", "assets", "content_references"],
      "properties": {
        "markdown_path": {
          "$ref": "#/$defs/relativePath"
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/asset"
          }
        },
        "content_references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contentReference"
          }
        },
        "cloud_markdown_path": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "severity"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": ["info", "warning", "error"]
        },
        "page": {
          "$ref": "#/$defs/pageReference"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "$ref": "#/$defs/pageReference"
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "warnings", "errors"],
      "properties": {
        "status": {
          "enum": ["ok", "warning", "error"]
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/warning"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      }
    }
  }
}
